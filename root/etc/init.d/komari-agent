#!/bin/sh /etc/rc.common
START=99
USE_PROCD=1
. /usr/libexec/komari-agent-common
start_service() {
 local memory_include_cache get_ip_addr_from_nic month_rotate enabled endpoint token interval disable_web_ssh ignore_unsafe_cert include_nics exclude_nics include_mountpoints
 config_load komari_agent
 config_get enabled main enabled '0'
 [ "$enabled" = 1 ] || return 0
 [ -x /usr/bin/komari-agent ] || { komari_error 'Komari Agent executable is not installed'; return 1; }
 komari_agent_load || return 1
 mkdir -p /tmp/komari-agent /var/log || return 1
 chmod 0700 /tmp/komari-agent
 procd_open_instance agent-log
 procd_set_param command /usr/libexec/komari-log-writer agent
 procd_set_param respawn 3600 5 5
 procd_close_instance
 procd_open_instance agent
 procd_set_param command /usr/libexec/komari-agent-run
 # Keep credentials out of process command arguments.
 procd_set_param env AGENT_ENDPOINT="$endpoint" AGENT_TOKEN="$token" AGENT_INTERVAL="$interval" AGENT_DISABLE_AUTO_UPDATE=true
 procd_append_param env AGENT_DISABLE_WEB_SSH="$([ "$disable_web_ssh" = 1 ] && echo true || echo false)" AGENT_IGNORE_UNSAFE_CERT="$([ "$ignore_unsafe_cert" = 1 ] && echo true || echo false)"
 procd_append_param env AGENT_INCLUDE_NICS="$include_nics" AGENT_EXCLUDE_NICS="$exclude_nics" AGENT_INCLUDE_MOUNTPOINTS="$include_mountpoints"
 procd_append_param env AGENT_MEMORY_INCLUDE_CACHE="$([ "$memory_include_cache" = 1 ] && echo true || echo false)" AGENT_GET_IP_ADDR_FROM_NIC="$([ "$get_ip_addr_from_nic" = 1 ] && echo true || echo false)" AGENT_MONTH_ROTATE="$month_rotate"
 procd_set_param stdout 1
 procd_set_param stderr 1
 procd_set_param respawn 3600 5 5
 procd_close_instance
}
reload_service() { pidof komari-agent >/dev/null 2>&1 || return 0; restart; }
service_triggers() { procd_add_reload_trigger komari_agent; }
